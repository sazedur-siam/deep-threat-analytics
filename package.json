{
  "name": "deep-threat-analytics",
  "displayName": "Deep Threat Analytics",
  "description": "Scans the source code of your dependencies for behavior that can compromise your system or leak data, plus known CVEs and package reputation.",
  "version": "0.0.1",
  "publisher": "sazedur-siam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sazedur-siam/deep-threat-analytics.git"
  },
  "bugs": {
    "url": "https://github.com/sazedur-siam/deep-threat-analytics/issues"
  },
  "homepage": "https://github.com/sazedur-siam/deep-threat-analytics#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "security",
    "dependencies",
    "supply chain",
    "malware",
    "vulnerability"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Python interpreter discovery and workspace-defined rule paths are disabled until the workspace is trusted."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "depthreat.scanWorkspace",
        "title": "Scan Workspace",
        "category": "DepThreat"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.mjs --production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "compile-tests": "tsc -p .",
    "pretest:integration": "npm run build && npm run compile-tests",
    "test:integration": "vscode-test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "^1.90.0",
    "@types/yarnpkg__lockfile": "^1.1.9",
    "@vitest/coverage-v8": "^5.0.5",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "pricing": "Free",
  "preview": "true",
  "qna": "marketplace",
  "galleryBanner": {
    "color": "#1b1f24",
    "theme": "dark"
  },
  "dependencies": {
    "@yarnpkg/lockfile": "^1.1.0",
    "picomatch": "^4.0.7",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
